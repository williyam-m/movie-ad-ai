PUBLIC_BASE_URL=http://localhost:7860
CHHONDO_DATA_DIR=./runtime
MAX_UPLOAD_BYTES=2147483648

ENABLE_ASR=true
ASR_MODEL_ID=tiny
ENABLE_VLM=true
VLM_MODEL_ID=HuggingFaceTB/SmolVLM2-256M-Video-Instruct
MAX_VLM_SCENES=36
ENABLE_SEMANTIC_MODEL=true
SEMANTIC_MODEL_ID=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
MODEL_CPU_THREADS=2

SCENE_THRESHOLD=0.18
MAX_ANALYSIS_SECONDS=7200